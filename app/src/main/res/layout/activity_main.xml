<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dashboard_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/dashboard_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="22dp"
            android:paddingEnd="16dp"
            android:paddingBottom="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.15"
                        android:text="FRONT / REAR DRIVE"
                        android:textColor="@color/accent"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-condensed"
                        android:text="小车遥控台"
                        android:textColor="@color/text"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="BLE 实时同步控制"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="78dp"
                    android:layout_height="70dp"
                    app:cardBackgroundColor="@color/surface_blue"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/online_count"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="0/2\n在线"
                        android:textColor="@color/text"
                        android:textSize="14sp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/DashboardCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView style="@style/SectionTitle" android:text="车轮连接" />
                            <TextView style="@style/SectionNote" android:text="分别选择前轮与后轮的 BLE 设备" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/adapter_state"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="正在检查蓝牙"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/adapter_action"
                            style="@style/TextAction"
                            android:text="初始化" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/slot_a_card"
                            style="@style/VehicleCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="14dp">

                                <TextView android:id="@+id/slot_a_name" style="@style/VehicleName" android:text="前轮" />
                                <TextView android:id="@+id/slot_a_status" style="@style/VehicleStatus" android:text="●  未连接" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="17dp"
                                    android:orientation="horizontal">
                                    <LinearLayout style="@style/MetaBox">
                                        <TextView style="@style/MetaLabel" android:text="档位" />
                                        <TextView android:id="@+id/slot_a_gear" style="@style/MetaValue" android:text="0" />
                                    </LinearLayout>
                                    <LinearLayout style="@style/MetaBox">
                                        <TextView style="@style/MetaLabel" android:text="状态" />
                                        <TextView android:id="@+id/slot_a_motion" style="@style/MetaSmall" android:text="静止" />
                                    </LinearLayout>
                                </LinearLayout>

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/slot_a_action"
                                    style="@style/SmallButton"
                                    android:text="选择设备" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/slot_b_card"
                            style="@style/VehicleCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="14dp">

                                <TextView android:id="@+id/slot_b_name" style="@style/VehicleName" android:text="后轮" />
                                <TextView android:id="@+id/slot_b_status" style="@style/VehicleStatus" android:text="●  未连接" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="17dp"
                                    android:orientation="horizontal">
                                    <LinearLayout style="@style/MetaBox">
                                        <TextView style="@style/MetaLabel" android:text="档位" />
                                        <TextView android:id="@+id/slot_b_gear" style="@style/MetaValue" android:text="0" />
                                    </LinearLayout>
                                    <LinearLayout style="@style/MetaBox">
                                        <TextView style="@style/MetaLabel" android:text="状态" />
                                        <TextView android:id="@+id/slot_b_motion" style="@style/MetaSmall" android:text="静止" />
                                    </LinearLayout>
                                </LinearLayout>

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/slot_b_action"
                                    style="@style/SmallButton"
                                    android:text="选择设备" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/DashboardCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView style="@style/SectionTitle" android:text="控制目标" />
                    <TextView style="@style/SectionNote" android:text="命令只发送给选中的在线车轮" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/target_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        app:checkedButton="@id/target_both"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/target_both"
                            style="@style/TargetOption"
                            android:text="前后同步" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/target_a"
                            style="@style/TargetOption"
                            android:text="仅前轮" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/target_b"
                            style="@style/TargetOption"
                            android:text="仅后轮" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/DashboardCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp">
                    <TextView
                        style="@style/SectionTitle"
                        android:layout_marginStart="4dp"
                        android:text="车轮控制" />
                    <TextView
                        style="@style/SectionNote"
                        android:layout_marginStart="4dp"
                        android:text="转向与倒车需持续按住" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/turn_left"
                            style="@style/ControlButton"
                            android:text="左转"
                            app:icon="@drawable/ic_turn_left" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/accelerate"
                            style="@style/ControlButtonAccent"
                            android:text="加速"
                            app:icon="@drawable/ic_accelerate" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/turn_right"
                            style="@style/ControlButton"
                            android:text="右转"
                            app:icon="@drawable/ic_turn_right" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/reverse"
                            style="@style/ControlButton"
                            android:text="长按倒车"
                            app:icon="@drawable/ic_reverse" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/stop_selected"
                            style="@style/ControlButtonDanger"
                            android:text="保持"
                            app:icon="@drawable/ic_hold" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/push_mode"
                            style="@style/ControlButton"
                            android:text="推行"
                            app:icon="@drawable/ic_push" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/DashboardCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView style="@style/SectionTitle" android:text="通信记录" />
                            <TextView style="@style/SectionNote" android:text="最近 6 条 BLE 事件" />
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/clear_logs"
                            style="@style/TextAction"
                            android:text="清空" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/log_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:background="@drawable/bg_log"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="3dp"
                        android:minHeight="112dp"
                        android:padding="16dp"
                        android:text="@string/log_empty"
                        android:textColor="@color/log_text"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/emergency_button"
        style="@style/EmergencyButton"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:enabled="false"
        android:text="全部急停"
        app:icon="@drawable/ic_emergency" />
</LinearLayout>
